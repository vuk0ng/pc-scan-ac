<Window x:Class="GModForensic.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner Forensic GMod" Height="640" Width="900"
        Background="#0D1413" Foreground="#E2EAE7"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

  <!-- Coquille minimale de l'ETAPE 3 : elle prouve que l'orchestrateur progresse et s'annule.
       L'interface complete (4 ecrans, MVVM, theme) est l'objet de l'etape 4. -->

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="SCANNER FORENSIC GMod" FontSize="22" FontWeight="SemiBold" />
      <TextBlock x:Name="CapabilitiesText" Foreground="#96A5A1" FontSize="12"
                 TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>

    <ProgressBar Grid.Row="1" x:Name="OverallProgress" Height="10" Minimum="0" Maximum="1"
                 Background="#1B2524" Foreground="#63B4AA" BorderThickness="0" />

    <Grid Grid.Row="2" Margin="0,10,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" x:Name="CurrentStepText" Text="Pret." Foreground="#96A5A1" />
      <TextBlock Grid.Column="1" x:Name="CountersText" Foreground="#96A5A1" />
    </Grid>

    <ListBox Grid.Row="3" x:Name="ModuleList" Background="#141C1B" Foreground="#E2EAE7"
             BorderBrush="#243130" FontFamily="Consolas" FontSize="12" />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="StartButton" Content="Lancer le scan" Padding="18,8" Margin="0,0,10,0"
              Click="OnStartClicked" />
      <Button x:Name="CancelButton" Content="Annuler" Padding="18,8" IsEnabled="False"
              Click="OnCancelClicked" />
    </StackPanel>
  </Grid>
</Window>
