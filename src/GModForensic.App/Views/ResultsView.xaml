<UserControl x:Class="GModForensic.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GModForensic.App.Converters">

  <UserControl.Resources>
    <conv:ToneToBrushConverter x:Key="Tone" />
    <conv:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
    <conv:FalseToVisibilityConverter x:Key="IsFalse" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Score et répartition -->
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Style="{StaticResource Eyebrow}" Text="SCORE DE SUSPICION" />
          <StackPanel Orientation="Horizontal">
            <TextBlock FontSize="46" FontWeight="SemiBold"
                       Foreground="{Binding Tone, Converter={StaticResource Tone}}"
                       Text="{Binding ScoreValue}" />
            <TextBlock FontSize="20" Foreground="{StaticResource Ink3}" VerticalAlignment="Bottom"
                       Margin="4,0,0,8" Text="/ 100" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource H2}" Margin="0"
                     Foreground="{Binding Tone, Converter={StaticResource Tone}}"
                     Text="{Binding BandLabel}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="{Binding BandGuidance}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" MaxWidth="620"
                     HorizontalAlignment="Left" Foreground="{StaticResource Ink3}"
                     Text="{Binding Disclaimer}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                     Foreground="{StaticResource ToneWarn}"
                     Visibility="{Binding WasCancelled, Converter={StaticResource NotEmpty}}"
                     Text="Scan interrompu — la couverture est incomplète." />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Margin="20,0,0,0">
            <TextBlock Style="{StaticResource Muted}" Text="Critiques" />
            <TextBlock Style="{StaticResource H1}" Foreground="{StaticResource ToneCrit}"
                       Text="{Binding Score.CriticalCount}" />
          </StackPanel>
          <StackPanel Margin="20,0,0,0">
            <TextBlock Style="{StaticResource Muted}" Text="Élevés" />
            <TextBlock Style="{StaticResource H1}" Foreground="{StaticResource ToneHigh}"
                       Text="{Binding Score.HighCount}" />
          </StackPanel>
          <StackPanel Margin="20,0,0,0">
            <TextBlock Style="{StaticResource Muted}" Text="Moyens" />
            <TextBlock Style="{StaticResource H1}" Foreground="{StaticResource ToneMed}"
                       Text="{Binding Score.MediumCount}" />
          </StackPanel>
          <StackPanel Margin="20,0,0,0">
            <TextBlock Style="{StaticResource Muted}" Text="Faibles" />
            <TextBlock Style="{StaticResource H1}" Foreground="{StaticResource ToneLow}"
                       Text="{Binding Score.LowCount}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Filtres -->
    <Grid Grid.Row="1" Margin="0,14,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ComboBox Grid.Column="0" ItemsSource="{Binding SeverityOptions}" DisplayMemberPath="Label"
                SelectedValuePath="Value" SelectedValue="{Binding SeverityFilter}" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}" />
      <TextBox  Grid.Column="4" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
      <Button   Grid.Column="6" Content="Réinitialiser" Command="{Binding ClearFiltersCommand}" />
    </Grid>

    <!-- Liste et détail -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
        <Grid>
          <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Text="{Binding EmptyMessage}"
                     Visibility="{Binding HasDetections, Converter={StaticResource IsFalse}}" />

          <ListBox ItemsSource="{Binding Detections}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- Bande de gravité : redondante avec le libellé, jamais seule porteuse de sens. -->
                  <Rectangle Grid.Column="0" Fill="{Binding Tone, Converter={StaticResource Tone}}"
                             RadiusX="2" RadiusY="2" />

                  <StackPanel Grid.Column="1" Margin="12,9,10,9">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10"
                                 Foreground="{Binding Tone, Converter={StaticResource Tone}}"
                                 Text="{Binding SeverityLabel}" />
                      <TextBlock Style="{StaticResource Mono}" FontSize="10" Margin="10,0,0,0"
                                 Foreground="{StaticResource Ink3}" Text="{Binding CategoryLabel}" />
                      <TextBlock Style="{StaticResource Mono}" FontSize="10" Margin="10,0,0,0"
                                 Foreground="{StaticResource Ink3}" Text="{Binding ScoreText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Name}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="0,2,0,0"
                               Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}">
          <StackPanel Visibility="{Binding Converter={StaticResource NotEmpty}}">

            <TextBlock Style="{StaticResource Eyebrow}" Text="{Binding SeverityLabel}" />
            <TextBlock Style="{StaticResource H1}" FontSize="19" Text="{Binding Name}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Style="{StaticResource Mono}" FontSize="11" Text="{Binding RuleId}" />
              <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="12,0,0,0"
                         Text="{Binding ConfidenceLabel}" />
            </StackPanel>

            <Border Style="{StaticResource Rule}" />

            <TextBlock Style="{StaticResource H2}" Text="Explication" />
            <TextBlock Style="{StaticResource Muted}" Text="{Binding Explanation}" />

            <TextBlock Style="{StaticResource H2}" Margin="0,16,0,8" Text="Pourquoi ce score" />
            <ItemsControl ItemsSource="{Binding ScoreLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Mono}" Text="{Binding}" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0" Foreground="{StaticResource Ink}"
                       Text="{Binding ScoreText, StringFormat=Total : {0}}" />

            <TextBlock Style="{StaticResource H2}" Margin="0,16,0,4" Foreground="{StaticResource ToneWarn}"
                       Text="Causes légitimes possibles" />
            <TextBlock Style="{StaticResource Muted}" Text="{Binding FalsePositiveNote}" />

            <Border Style="{StaticResource Rule}" />

            <TextBlock Style="{StaticResource H2}" Text="Élément concerné" />
            <TextBlock Style="{StaticResource Mono}" Text="{Binding Path}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0" Text="{Binding TimestampText}" />
            <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0"
                       Text="{Binding Source, StringFormat=Source : {0}}" TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource H2}" Margin="0,16,0,8" Text="Preuve brute" />
            <ItemsControl ItemsSource="{Binding Evidence}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource Surface2}" CornerRadius="3" Padding="10" Margin="0,0,0,6">
                    <StackPanel>
                      <TextBlock Style="{StaticResource Mono}" FontSize="10"
                                 Foreground="{StaticResource Ink3}" Text="{Binding Kind}" />
                      <TextBlock Style="{StaticResource Mono}" Margin="0,3,0,0" Text="{Binding Locator}"
                                 TextWrapping="Wrap" />
                      <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0" Text="{Binding RawText}"
                                 TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="11"
                                 Text="{Binding VerificationHint}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Nouveau scan" Command="{Binding NewScanCommand}" Margin="0,0,10,0" />
      <Button Style="{StaticResource PrimaryButton}" Content="Exporter le rapport"
              Command="{Binding ExportCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
