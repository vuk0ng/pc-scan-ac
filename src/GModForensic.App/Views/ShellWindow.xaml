<Window x:Class="GModForensic.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GModForensic.Presentation;assembly=GModForensic.Presentation"
        xmlns:views="clr-namespace:GModForensic.App.Views"
        Title="Scanner Forensic GMod" Height="820" Width="1280"
        MinHeight="640" MinWidth="1024"
        Background="{StaticResource Ground}" Foreground="{StaticResource Ink}"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- Chaque ViewModel sait quelle vue le represente ; le shell n'a aucune logique de navigation. -->
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ScanViewModel}">
      <views:ScanView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ResultsViewModel}">
      <views:ResultsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ExportViewModel}">
      <views:ExportView />
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="0,0,0,1" Padding="28,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock FontSize="15" FontWeight="SemiBold" Text="SCANNER FORENSIC GMod" />
          <TextBlock Style="{StaticResource Mono}" Margin="14,3,0,0" Foreground="{StaticResource Ink3}"
                     Text="scan passif · lecture seule" />
        </StackPanel>
        <TextBlock Grid.Column="1" Style="{StaticResource Mono}" Foreground="{StaticResource Ink3}"
                   Text="{Binding ScreenLabel}" />
      </Grid>
    </Border>

    <ContentControl Grid.Row="1" Content="{Binding Current}" Margin="28,24" />

    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="0,1,0,0" Padding="28,10">
      <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Ink3}"
                 TextWrapping="Wrap"
                 Text="Ce logiciel recense des indicateurs. Aucun élément qu'il produit ne constitue à lui seul une preuve d'utilisation de cheat." />
    </Border>
  </Grid>
</Window>
